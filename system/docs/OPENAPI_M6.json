      "AnalyzeRequest": {
        "additionalProperties": false,
        "description": "The UI supplies one prompt; never a response, probe list, or API key.\n\nUnknown fields are rejected so that a user cannot accidentally post an\nAPI key to this mock-only endpoint.",
        "properties": {
          "prompt_text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Prompt Text",
            "type": "string"
          },
          "use_stage1": {
            "default": false,
            "title": "Use Stage1",
            "type": "boolean"
          }
        },
        "required": [
          "prompt_text"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "description": "A completed synchronous MOCK report, not a live fingerprint result.",
        "properties": {
          "change_status": {
            "title": "Change Status",
            "type": "string"
          },
          "mode": {
            "const": "mock",
            "default": "mock",
            "title": "Mode",
            "type": "string"
          },
          "model_card_status": {
            "title": "Model Card Status",
            "type": "string"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "stage1_enabled": {
            "title": "Stage1 Enabled",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "identified",
              "verified",
              "drift_detected",
              "needs_review",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "target_queries": {
            "items": {
              "type": "string"
            },
            "title": "Target Queries",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "status",
          "model_id",
          "stage1_enabled",
          "model_card_status",
          "change_status",
          "target_queries",
          "report"
