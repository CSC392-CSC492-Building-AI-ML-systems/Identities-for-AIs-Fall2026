            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Model Id",
            "type": "string"
          },
          "review_note": {
            "maxLength": 500,
            "minLength": 10,
            "title": "Review Note",
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "acknowledge_manual_review",
          "review_note"
        ],
        "title": "ManualBaselineCreate",
        "type": "object"
      },
      "ModelCardView": {
        "properties": {
          "card": {
            "title": "Card",
            "type": "null"
          },
          "model_id": {
            "title": "Model Id",
            "type": "null"
          },
          "status": {
            "const": "unavailable",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ModelCardView",
        "type": "object"
      },
      "ResultEvidenceView": {
        "properties": {
          "baseline_auto_updated": {
            "const": false,
            "title": "Baseline Auto Updated",
            "type": "boolean"
          },
          "identity_confirmed": {
            "const": false,
            "title": "Identity Confirmed",
            "type": "boolean"
          },
          "judge": {
            "const": "mock",
            "title": "Judge",
            "type": "string"
          },
          "target_provider": {
            "const": "openai",
            "title": "Target Provider",
            "type": "string"
          }
        },
        "required": [
          "target_provider",
          "judge",
          "identity_confirmed",
          "baseline_auto_updated"
        ],
        "title": "ResultEvidenceView",
        "type": "object"
      },
      "UnifiedLiveResult": {
        "description": "Safe, typed UI result. Raw report remains for research diagnostics.",
        "properties": {
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaselineReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "comparison": {
            "$ref": "#/components/schemas/ComparisonView"
          },
          "evidence": {
            "$ref": "#/components/schemas/ResultEvidenceView"
          },
          "identification": {
            "$ref": "#/components/schemas/IdentificationView"
          },
          "model_card": {
            "$ref": "#/components/schemas/ModelCardView"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "identification",
          "comparison",
          "model_card",
          "baseline",
          "evidence"
        ],
        "title": "UnifiedLiveResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
