      "CreateLiveJobRequest": {
        "additionalProperties": false,
        "description": "Authenticated live job. Link to a reviewed deployment when available.\n\nIf linked, the backend derives the routing model from that owned deployment;\nno user-provided routing value is ever treated as an inferred identity.",
        "properties": {
          "api_key": {
            "format": "password",
            "title": "Api Key",
            "type": "string",
            "writeOnly": true
          },
          "deployment_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment Id"
          },
          "prompt_text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Prompt Text",
            "type": "string"
          },
          "provider": {
            "const": "openai",
            "default": "openai",
            "title": "Provider",
            "type": "string"
          },
          "target_model": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Model"
          },
          "use_stage1": {
            "default": false,
            "title": "Use Stage1",
            "type": "boolean"
          }
        },
        "required": [
          "prompt_text",
          "api_key"
        ],
        "title": "CreateLiveJobRequest",
        "type": "object"
      },
